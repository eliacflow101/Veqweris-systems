rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function signedIn() {
      let membershipPath = /databases/$(database)/documents/memberships/$(request.auth.uid);
      return authenticated()
        && request.auth.token.pt == "staff"
        && request.auth.token.tier in ["Owner", "Admin", "Manager", "Employee"]
        && request.auth.token.iid is string
        && request.auth.token.pv is int
        && exists(membershipPath)
        && get(membershipPath).data.institutionId == request.auth.token.iid
        && get(membershipPath).data.tier == request.auth.token.tier
        && get(membershipPath).data.permissionVersion == request.auth.token.pv
        && get(membershipPath).data.status == "active";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function membershipDoc(uid) {
      return get(/databases/$(database)/documents/memberships/$(uid));
    }

    function hasPermission(permission) {
      let permissionsPath = /databases/$(database)/documents/effectivePermissions/$(request.auth.uid);
      return authenticated()
        && request.auth.token.pt == "staff"
        && exists(permissionsPath)
        && get(permissionsPath).data.institutionId == request.auth.token.iid
        && get(permissionsPath).data.version == request.auth.token.pv
        && permission in get(permissionsPath).data.permissionKeys;
    }

    function sameInstitution(institutionId) {
      return signedIn()
        && request.auth.token.iid == institutionId
        && get(/databases/$(database)/documents/institutions/$(institutionId)).data.status == "active";
    }

    function hasRole(role) {
      return signedIn()
        && (request.auth.token.tier == role
          || (!(role in ["Owner", "Admin", "Manager", "Employee"])
            && request.auth.token.legacyRole == role));
    }

    function ownerOrAdmin() {
      return hasRole("Owner") || hasRole("Admin");
    }

    function signupPlanAllowsInitialUser() {
      let basicPlanPath = /databases/$(database)/documents/platformPlanCatalog/basic;
      return !exists(basicPlanPath)
        || (
          get(basicPlanPath).data.status == "active"
          && "limits" in get(basicPlanPath).data
          && (
            get(basicPlanPath).data.limits.maxUsers == -1
            || get(basicPlanPath).data.limits.maxUsers >= 1
          )
        );
    }

    function institutionHasModule(moduleId) {
      return signedIn() && institutionHasModuleFor(request.auth.token.iid, moduleId);
    }

    function institutionHasModuleFor(institutionId, moduleId) {
      let institution = get(/databases/$(database)/documents/institutions/$(institutionId)).data;
      return institution.status == "active"
        && (
          ("entitlement" in institution
            && "modules" in institution.entitlement
            && moduleId in institution.entitlement.modules)
          || (!("entitlement" in institution)
            && (
              institution.planTier in ["internal", "developer", "partner", "enterprise"]
              || (institution.planTier in ["trial", "basic"]
                && moduleId in ["dashboard", "departments", "employees", "tasks", "planner", "messages", "notifications", "documents", "reports", "approvals", "settings", "inventory", "setup"])
              || (institution.planTier == "professional"
                && moduleId in ["dashboard", "departments", "employees", "tasks", "planner", "messages", "notifications", "documents", "reports", "approvals", "settings", "inventory", "setup", "compliance", "analytics", "operational-intelligence", "network", "school", "healthcare", "hospitality"])
            ))
        );
    }

    function institutionHasFeature(featureId) {
      return signedIn() && institutionHasFeatureFor(request.auth.token.iid, featureId);
    }

    function institutionHasFeatureFor(institutionId, featureId) {
      let institution = get(/databases/$(database)/documents/institutions/$(institutionId)).data;
      return institution.status == "active"
        && (
          ("entitlement" in institution
            && "features" in institution.entitlement
            && featureId in institution.entitlement.features)
          || (!("entitlement" in institution)
            && (
              institution.planTier in ["internal", "developer", "partner", "enterprise"]
              || (institution.planTier == "professional"
                && featureId in ["external-integrations", "institutional-network", "document-automation", "data-export"])
            ))
        );
    }

    function platformControlledInstitutionKeys() {
      return ["status", "planTier", "relationship", "subscription", "entitlement", "policies",
        "securityState", "billingState", "platformUpdatedAt", "platformUpdatedBy"];
    }

    function setupOperator() {
      return ownerOrAdmin() || hasRole("Manager");
    }

    function managerOfDepartment(departmentId) {
      return hasRole("Manager")
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid))
        && departmentId in membershipDoc(request.auth.uid).data.departmentIds;
    }

    function healthcareRole() {
      return institutionHasModuleFor(request.auth.token.iid, "healthcare")
        && (request.auth.token.tier in ["Owner", "Admin", "Manager"]
          || request.auth.token.legacyRole in ["Clinician", "Nurse", "Reception", "Billing", "Laboratory", "Pharmacist"]);
    }

    function healthcareSensitiveAccess() {
      let profile = userDoc(request.auth.uid).data;
      return request.auth.token.tier in ["Owner", "Admin"]
        || hasPermission("health.record.read")
        || ("healthcarePermissions" in profile
          && "sensitive" in profile.healthcarePermissions)
        || ("healthcarePermissions" in profile
          && "highly_sensitive" in profile.healthcarePermissions);
    }

    function healthcareRecordScope(record) {
      let profile = userDoc(request.auth.uid).data;
      let tier = request.auth.token.tier;
      let role = request.auth.token.legacyRole;
      return sameInstitution(record.institutionId)
        && healthcareRole()
        && (record.sensitivity == "standard" || healthcareSensitiveAccess())
        && (!("departmentId" in record)
          || record.departmentId == null
          || tier in ["Owner", "Admin"]
          || (tier == "Manager" && profile.departmentId == record.departmentId)
          || role in ["Clinician", "Nurse", "Reception", "Billing", "Laboratory", "Pharmacist"]);
    }

    function assignedPatient(record) {
      let profile = userDoc(request.auth.uid).data;
      return !("patientId" in record)
        || !(request.auth.token.legacyRole in ["Clinician", "Nurse"])
        || ("assignedPatientIds" in profile
          && record.patientId in profile.assignedPatientIds);
    }

    function specialtyScope(record) {
      let profile = userDoc(request.auth.uid).data;
      return !("specialtyId" in record) || record.specialtyId == null
        || request.auth.token.tier in ["Owner", "Admin"]
        || (("specialtyId" in profile)
          && profile.specialtyId == record.specialtyId)
        || (("specialtyIds" in profile)
          && record.specialtyId in profile.specialtyIds);
    }

    match /operationalIntelligence/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("operational-intelligence");
      allow create: if signedIn() && sameInstitution(request.resource.data.institutionId) && institutionHasModule("operational-intelligence")
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /institutions/{institutionId} {
      allow create: if authenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.institutionId == institutionId
        && request.resource.data.status == "active"
        && request.resource.data.planTier == "trial"
        && request.resource.data.keys().hasOnly(["institutionId", "createdBy", "name", "country", "location", "status", "planTier", "createdAt"])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId == institutionId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Owner";
      allow read: if sameInstitution(institutionId);
      allow update: if sameInstitution(institutionId) && ownerOrAdmin()
        && request.resource.data.institutionId == resource.data.institutionId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(platformControlledInstitutionKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "country", "location", "updatedAt"]);
      allow delete: if false;
    }

    match /platformOperators/{uid} {
      allow read, write: if false;
    }

    match /platformSupportGrants/{grantId} {
      allow read, write: if false;
    }

    match /platformAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /platformMonitoringSignals/{signalId} {
      allow read, write: if false;
    }

    match /platformBootstrap/{bootstrapId} {
      allow read, write: if false;
    }

    match /platformMetadata/{metadataId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow create: if authenticated()
        && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "Owner"
        && signupPlanAllowsInitialUser()
        && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.institutionId == request.resource.data.institutionId
        && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.createdBy == request.auth.uid;
      allow read: if signedIn() && (uid == request.auth.uid || (sameInstitution(resource.data.institutionId) && institutionHasModule("employees")));
      allow update: if signedIn() && (
        (uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName", "email", "phone", "photoUrl", "preferences", "lastActive", "sessionPolicy"
          ]))
        || (ownerOrAdmin() && resource.data.role != "Owner"
          && sameInstitution(resource.data.institutionId) && institutionHasModule("employees")
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.institutionId == resource.data.institutionId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName", "phone", "photoUrl", "departmentId", "lastActive"
          ]))
      );
      allow delete: if false;
    }

    match /memberships/{uid} {
      allow read: if signedIn() && uid == request.auth.uid
        && resource.data.institutionId == request.auth.token.iid;
      allow create, update, delete: if false;
    }

    match /effectivePermissions/{uid} {
      allow read: if signedIn() && uid == request.auth.uid
        && resource.data.institutionId == request.auth.token.iid
        && resource.data.version == request.auth.token.pv;
      allow create, update, delete: if false;
    }

    match /roles/{roleId} {
      allow read, write: if false;
    }

    match /roleVersions/{versionId} {
      allow read, write: if false;
    }

    match /permissionSets/{permissionSetId} {
      allow read, write: if false;
    }

    match /portalAccounts/{uid} {
      allow read: if authenticated() && request.auth.token.pt == "external"
        && uid == request.auth.uid
        && resource.data.status == "active"
        && request.auth.token.iid == resource.data.institutionId;
      allow create, update, delete: if false;
    }

    match /locations/{locationId} {
      allow read, write: if false;
    }

    match /operationalUnits/{unitId} {
      allow read, write: if false;
    }

    match /teams/{teamId} {
      allow read, write: if false;
    }

    match /departments/{departmentId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("departments");
      allow create: if false;
      allow update: if sameInstitution(resource.data.institutionId)
        && institutionHasModule("departments")
        && request.resource.data.departmentId == resource.data.departmentId
        && request.resource.data.institutionId == resource.data.institutionId
        && (
          ownerOrAdmin()
          || (
            managerOfDepartment(departmentId)
            && resource.data.headUserId == request.auth.uid
            && request.resource.data.headUserId == request.auth.uid
          )
        );
      allow delete: if ownerOrAdmin()
        && sameInstitution(resource.data.institutionId)
        && institutionHasModule("departments");
    }

    function schoolStaff() {
      return institutionHasModule("school") && (ownerOrAdmin() || hasRole("Manager"));
    }

    function hasSchoolPermission(permission) {
      return signedIn()
        && institutionHasModule("school")
        && (hasPermission(permission)
          || (userDoc(request.auth.uid).data.schoolPermissions != null
            && permission in userDoc(request.auth.uid).data.schoolPermissions));
    }

    match /schoolProfiles/{profileId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if ownerOrAdmin()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /academicYears/{academicYearId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if ownerOrAdmin()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /academicLevels/{levelId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if ownerOrAdmin() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /schoolClasses/{classId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin();
    }

    match /schoolStreams/{streamId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin();
    }

    match /schoolSubjects/{subjectId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin();
    }

    match /curricula/{curriculumId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin();
    }

    match /students/{studentId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /academicEnrollments/{enrollmentId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /guardians/{guardianId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /studentGuardianLinks/{linkId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /libraryLoans/{loanId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasSchoolPermission("school.library.read"));
      allow create, update: if schoolStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasSchoolPermission("school.library.manage"));
      allow delete: if false;
    }

    match /transportRoutes/{routeId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasSchoolPermission("school.transport.read"));
      allow create, update: if schoolStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasSchoolPermission("school.transport.manage"));
      allow delete: if false;
    }

    match /hostelRooms/{roomId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasSchoolPermission("school.hostel.read"));
      allow create, update: if schoolStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasSchoolPermission("school.hostel.manage"));
      allow delete: if false;
    }

    match /schoolHealthRecords/{recordId} {
      allow read, update: if sameInstitution(resource.data.institutionId)
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.health.sensitive"));
      allow create: if request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.health.sensitive"));
      allow delete: if false;
    }

    match /welfareIncidents/{incidentId} {
      allow read, update: if sameInstitution(resource.data.institutionId)
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.welfare.sensitive"));
      allow create: if request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.welfare.sensitive"));
      allow delete: if false;
    }

    match /safeguardingCases/{caseId} {
      allow read, update: if sameInstitution(resource.data.institutionId)
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.safeguarding.sensitive"));
      allow create: if request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && institutionHasModule("school")
        && (ownerOrAdmin() || hasSchoolPermission("school.safeguarding.sensitive"));
      allow delete: if false;
    }

    match /placementReviews/{placementReviewId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("school");
      allow create, update: if schoolStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    function healthcareStaff() {
      return institutionHasModule("healthcare") && healthcareRole();
    }

    match /healthcareProfiles/{profileId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("healthcare");
      allow create, update: if ownerOrAdmin()
        && institutionHasModule("healthcare")
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /patientIdentities/{patientId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if healthcareStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareEncounters/{encounterId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if healthcareStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareServices/{serviceId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if (ownerOrAdmin() || hasRole("Manager"))
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareQueue/{queueEntryId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if healthcareStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareServicePoints/{servicePointId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if (ownerOrAdmin() || hasRole("Manager") || hasRole("Reception"))
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareResources/{resourceId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if (ownerOrAdmin() || hasRole("Manager") || hasRole("Billing"))
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /clinicalRecords/{clinicalRecordId} {
      allow read: if healthcareRecordScope(resource.data) && assignedPatient(resource.data) && specialtyScope(resource.data)
        && (request.auth.token.tier in ["Owner", "Admin"]
          || request.auth.token.legacyRole in ["Clinician", "Nurse"]);
      allow create, update: if healthcareRecordScope(request.resource.data) && assignedPatient(request.resource.data) && specialtyScope(request.resource.data)
        && (request.auth.token.legacyRole in ["Clinician", "Nurse"]
          || request.auth.token.tier in ["Owner", "Admin"]);
      allow delete: if false;
    }

    match /billingReferences/{billingReferenceId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasRole("Manager") || hasRole("Billing"));
      allow create, update: if (ownerOrAdmin() || hasRole("Manager") || hasRole("Billing"))
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /healthcareDocuments/{healthcareDocumentId} {
      allow read: if sameInstitution(resource.data.institutionId) && healthcareStaff();
      allow create, update: if healthcareStaff()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /laboratoryRequests/{requestId} {
      allow read: if healthcareRecordScope(resource.data) && assignedPatient(resource.data) && specialtyScope(resource.data)
        && (ownerOrAdmin() || hasRole("Clinician") || hasRole("Nurse") || hasRole("Laboratory") || hasRole("Billing"));
      allow create: if healthcareRecordScope(request.resource.data) && assignedPatient(request.resource.data) && specialtyScope(request.resource.data)
        && (ownerOrAdmin() || hasRole("Clinician") || hasRole("Nurse") || hasRole("Reception"));
      allow update: if healthcareRecordScope(resource.data) && healthcareRecordScope(request.resource.data)
        && (ownerOrAdmin() || hasRole("Clinician") || hasRole("Nurse") || hasRole("Laboratory"));
      allow delete: if false;
    }

    match /laboratorySamples/{sampleId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasRole("Clinician") || hasRole("Nurse") || hasRole("Laboratory"));
      allow create, update: if signedIn()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasRole("Nurse") || hasRole("Laboratory"));
      allow delete: if false;
    }

    match /laboratoryResults/{resultId} {
      allow read: if healthcareRecordScope(resource.data) && assignedPatient(resource.data) && specialtyScope(resource.data)
        && (ownerOrAdmin() || hasRole("Clinician") || hasRole("Nurse") || hasRole("Laboratory"));
      allow create: if healthcareRecordScope(request.resource.data) && assignedPatient(request.resource.data) && specialtyScope(request.resource.data)
        && (ownerOrAdmin() || hasRole("Laboratory"));
      allow update: if healthcareRecordScope(resource.data) && healthcareRecordScope(request.resource.data)
        && (ownerOrAdmin() || hasRole("Laboratory") || hasRole("Clinician"));
      allow delete: if false;
    }

    match /pharmacyMedicines/{medicineId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasRole("Pharmacist") || hasRole("Manager") || hasRole("Clinician") || hasRole("Billing"));
      allow create, update: if signedIn()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasRole("Pharmacist") || hasRole("Manager"));
      allow delete: if false;
    }

    match /pharmacyBatches/{batchId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || hasRole("Pharmacist") || hasRole("Manager") || hasRole("Clinician"));
      allow create, update: if signedIn()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (ownerOrAdmin() || hasRole("Pharmacist") || hasRole("Manager"));
      allow delete: if false;
    }

    match /pharmacyDispenses/{dispenseId} {
      allow read: if healthcareRecordScope(resource.data) && assignedPatient(resource.data) && specialtyScope(resource.data)
        && (ownerOrAdmin() || hasRole("Pharmacist") || hasRole("Clinician") || hasRole("Billing"));
      allow create, update: if healthcareRecordScope(request.resource.data) && assignedPatient(request.resource.data) && specialtyScope(request.resource.data)
        && (ownerOrAdmin() || hasRole("Pharmacist"));
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("tasks");
      allow create: if signedIn() && institutionHasModule("tasks")
        && request.resource.data.taskId == taskId
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && request.resource.data.status in ["todo", "in_progress", "review", "done"]
        && request.resource.data.priority in ["low", "medium", "high"]
        && (
          ownerOrAdmin()
          || (
            hasRole("Manager")
            && request.resource.data.departmentId == userDoc(request.auth.uid).data.departmentId
          )
        );
      allow update: if sameInstitution(resource.data.institutionId) && institutionHasModule("tasks")
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.institutionId == resource.data.institutionId
        && (
          ownerOrAdmin()
          || (
            hasRole("Manager")
            && resource.data.departmentId == userDoc(request.auth.uid).data.departmentId
          )
          || (
            hasRole("Employee")
            && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.departmentId == resource.data.departmentId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
          )
        );
      allow delete: if ownerOrAdmin()
        && sameInstitution(resource.data.institutionId)
        && institutionHasModule("tasks");
    }

    match /plannerEvents/{eventId} {
      allow read: if sameInstitution(resource.data.institutionId)
        && (
          !hasRole("Employee")
          || resource.data.departmentId == null
          || (resource.data.attendees != null && request.auth.uid in resource.data.attendees)
        );
      allow create: if signedIn()
        && request.resource.data.eventId == eventId
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && request.resource.data.createdBy == request.auth.uid
        && (
          ownerOrAdmin()
          || (
            hasRole("Manager")
            && request.resource.data.departmentId == userDoc(request.auth.uid).data.departmentId
          )
        );
      allow update: if sameInstitution(resource.data.institutionId)
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          ownerOrAdmin()
          || (
            managerOfDepartment(resource.data.departmentId)
            && resource.data.departmentId == userDoc(request.auth.uid).data.departmentId
            && request.resource.data.departmentId == resource.data.departmentId
          )
        );
      allow delete: if sameInstitution(resource.data.institutionId)
        && (
          ownerOrAdmin()
          || managerOfDepartment(resource.data.departmentId)
        );
    }

    match /approvals/{approvalId} {
      allow create: if signedIn()
        && request.resource.data.approvalId == approvalId
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (
          request.auth.uid == request.resource.data.requesterUid
          || ownerOrAdmin()
          || (hasRole("Manager") && request.resource.data.departmentId == userDoc(request.auth.uid).data.departmentId)
        );
      allow read: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && (
          request.auth.uid == resource.data.requesterUid
          || request.auth.uid == resource.data.approverUid
          || request.auth.uid == resource.data.assigneeUid
          || ownerOrAdmin()
          || (hasRole("Manager") && resource.data.departmentId == userDoc(request.auth.uid).data.departmentId)
        );
      allow update: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && request.resource.data.approvalId == resource.data.approvalId
        && request.resource.data.institutionId == resource.data.institutionId
        && (
          ownerOrAdmin()
          || request.auth.uid == resource.data.requesterUid
          || request.auth.uid == resource.data.approverUid
          || request.auth.uid == resource.data.assigneeUid
        );
      allow delete: if sameInstitution(resource.data.institutionId) && ownerOrAdmin();

      match /audit/{entryId} {
        allow read: if signedIn() && sameInstitution(get(/databases/$(database)/documents/approvals/$(approvalId)).data.institutionId);
        allow create, update: if signedIn()
          && request.resource.data.eventId == entryId
          && get(/databases/$(database)/documents/approvals/$(approvalId)).data.institutionId == userDoc(request.auth.uid).data.institutionId
          && (
            ownerOrAdmin()
            || request.auth.uid == get(/databases/$(database)/documents/approvals/$(approvalId)).data.requesterUid
            || request.auth.uid == get(/databases/$(database)/documents/approvals/$(approvalId)).data.approverUid
          );
        allow delete: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && (
          request.auth.uid in resource.data.participantIds
          || resource.data.type == "institution_wide"
          || (resource.data.type == "department"
            && resource.data.departmentId == userDoc(request.auth.uid).data.departmentId)
        );
      allow create: if signedIn()
        && request.resource.data.conversationId == conversationId
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && (request.auth.uid in request.resource.data.participantIds || request.resource.data.type == "institution_wide")
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ["direct", "department", "institution_wide"]
        && (
          request.resource.data.type == "institution_wide"
          || request.resource.data.type == "direct"
          || ownerOrAdmin()
          || (
            hasRole("Manager")
            && request.resource.data.departmentId == userDoc(request.auth.uid).data.departmentId
          )
        );
      allow update: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessagePreview", "lastMessageAt", "title"]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.institutionId == userDoc(request.auth.uid).data.institutionId
          && (
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "institution_wide"
            || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == "department"
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.departmentId == get(/databases/$(database)/documents/conversations/$(conversationId)).data.departmentId)
          );
        allow create: if signedIn()
          && request.resource.data.messageId == messageId
          && request.resource.data.conversationId == conversationId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.institutionId == get(/databases/$(database)/documents/conversations/$(conversationId)).data.institutionId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.type in ["text", "call_link"]
          && (request.resource.data.type == "text" || request.resource.data.callUrl is string);
        allow update, delete: if false;
      }

      // Documents collection: tenant-scoped, role-aware access control
      match /documents/{documentId} {
        allow create: if signedIn()
          && institutionHasModule("documents")
          && request.resource.data.documentId == documentId
          && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.status in ["UPLOADED","QUEUED","PROCESSING","EXTRACTED","NEEDS_REVIEW","VALIDATED","VERIFIED","AVAILABLE","FAILED","UNSUPPORTED","REJECTED"]
          && request.resource.data.size is number
          && request.resource.data.storagePath is string;

        allow read: if signedIn()
          && sameInstitution(resource.data.institutionId)
          && institutionHasModule("documents")
          && (
            ownerOrAdmin()
            || request.auth.uid == resource.data.uploadedBy
            || (resource.data.departmentId == null)
            || (hasRole("Manager") && userDoc(request.auth.uid).data.departmentId == resource.data.departmentId)
            || (resource.data.allowedViewers != null && request.auth.uid in resource.data.allowedViewers)
          );

        allow update: if signedIn()
          && sameInstitution(resource.data.institutionId)
          && institutionHasModule("documents")
          && request.resource.data.documentId == resource.data.documentId
          && request.resource.data.institutionId == resource.data.institutionId
          && (
            ownerOrAdmin()
            || request.auth.uid == resource.data.uploadedBy
          );

        allow delete: if sameInstitution(resource.data.institutionId) && institutionHasModule("documents") && ownerOrAdmin();
      }

      match /bulkImportBatches/{batchId} {
        // Bulk import batches are institution-scoped and only Owners/Admins may create and manage batches
        allow create: if signedIn()
          && request.resource.data.batchId == batchId
          && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status in ["pending_review", "confirmed", "created", "rejected"];

        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && (
          ownerOrAdmin()
          || request.auth.uid == resource.data.createdBy
        );

        allow update: if signedIn() && sameInstitution(resource.data.institutionId) && (
          ownerOrAdmin() || request.auth.uid == resource.data.createdBy
        );

        allow delete: if signedIn() && sameInstitution(resource.data.institutionId) && ownerOrAdmin();
      }

      match /securityEvents/{eventId} {
        // Client-created events are limited to self-attributed authentication and workspace activity.
        allow create: if signedIn()
          && request.resource.data.eventId == eventId
          && request.resource.data.institutionId == institutionId
          && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(["eventId", "institutionId", "uid", "type", "source", "details", "createdAt"])
          && request.resource.data.type in ["login", "workspace_lock", "workspace_unlock"]
          && request.resource.data.source in ["create_account", "login_form", "workspace_lock", "workspace_unlock", "idle_timer"]
          && request.resource.data.details is map
          && (
            (request.resource.data.type == "login" && request.resource.data.source in ["create_account", "login_form"])
            || (request.resource.data.type == "workspace_lock" && request.resource.data.source in ["workspace_lock", "idle_timer"])
            || (request.resource.data.type == "workspace_unlock" && request.resource.data.source in ["workspace_lock", "workspace_unlock"])
          );

        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && (
          ownerOrAdmin() || request.auth.uid == resource.data.uid
        );

        allow update, delete: if false;
      }

      match /securitySessions/{sessionId} {
        allow read: if signedIn()
          && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.uid);
        allow create, update, delete: if false;
      }

      match /analyticsSnapshots/{snapshotId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("analytics");
        allow create: if signedIn() && ownerOrAdmin()
          && institutionHasModule("analytics")
          && sameInstitution(request.resource.data.institutionId)
          && request.resource.data.metricId is string
          && request.resource.data.snapshotId == snapshotId;
        allow update, delete: if false;
      }

      match /analyticsExportAudit/{exportId} {
        allow read: if signedIn() && ownerOrAdmin() && sameInstitution(resource.data.institutionId) && institutionHasModule("analytics");
        allow create, update, delete: if false;
      }

      match /governanceChains/{chainId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId);
        allow create, update: if signedIn() && ownerOrAdmin()
          && sameInstitution(request.resource.data.institutionId)
          && request.resource.data.chainId == chainId;
        allow delete: if false;
      }

      match /governanceFindings/{findingId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId);
        allow create, update: if signedIn() && (ownerOrAdmin() || hasRole("Manager"))
          && sameInstitution(request.resource.data.institutionId)
          && request.resource.data.findingId == findingId;
        allow delete: if false;
      }

      match /governanceEvidence/{evidenceId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId);
        allow create: if signedIn() && ownerOrAdmin()
          && sameInstitution(request.resource.data.institutionId)
          && request.resource.data.evidenceId == evidenceId;
        allow update, delete: if false;
      }

      match /governanceAuditEvents/{eventId} {
        allow read: if signedIn() && ownerOrAdmin() && sameInstitution(resource.data.institutionId);
        allow create, update, delete: if false;
      }

      match /governanceDataQuality/{issueId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId);
        allow create, update: if signedIn() && ownerOrAdmin() && sameInstitution(request.resource.data.institutionId);
        allow delete: if false;
      }

      match /governanceConflicts/{conflictId} {
        allow read: if signedIn() && ownerOrAdmin() && sameInstitution(resource.data.institutionId);
        allow create, update: if signedIn() && ownerOrAdmin() && sameInstitution(request.resource.data.institutionId);
        allow delete: if false;
      }

      match /breakGlassAccess/{accessId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || resource.data.uid == request.auth.uid);
        allow create: if signedIn() && ownerOrAdmin()
          && sameInstitution(request.resource.data.institutionId)
          && request.resource.data.accessId == accessId
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time;
        allow update, delete: if false;
      }

      match /recoveryRequests/{requestId} {
        allow read, write: if false;
      }

      match /terminalProfiles/{terminalId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId);
        allow write: if false;
      }

      match /terminalSessions/{sessionId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.uid);
        allow write: if false;
      }

      match /inventoryItems/{itemId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("inventory");
        allow create, update: if signedIn()
          && institutionHasModule("inventory")
          && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
          && (ownerOrAdmin() || hasRole("Manager") || hasRole("Operator") || hasRole("Service Worker"));
        allow delete: if ownerOrAdmin() && institutionHasModule("inventory");
      }

      match /inventoryMovements/{movementId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("inventory");
        allow create, update, delete: if false;
      }

      match /inventoryReservations/{reservationId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("inventory");
        allow create, update: if signedIn()
          && institutionHasModule("inventory")
          && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
          && (ownerOrAdmin() || hasRole("Manager") || hasRole("Operator"));
        allow delete: if false;
      }

    }

    match /bills/{billId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.customerUid);
        allow create, update, delete: if false;
      }

    match /payments/{paymentId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.customerUid);
        allow create, update, delete: if false;
      }

    match /paymentIdempotency/{idempotencyId} {
        allow read, write: if false;
      }

    match /paymentWebhookEvents/{eventId} {
        allow read, write: if false;
      }

    match /refunds/{refundId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.requestedBy);
        allow create, update, delete: if false;
      }

    match /receipts/{receiptId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId)
          && (ownerOrAdmin() || request.auth.uid == resource.data.customerUid);
        allow write: if false;
      }

    match /financialEvents/{eventId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && ownerOrAdmin();
        allow write: if false;
      }

    match /financialReconciliations/{reconciliationId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && ownerOrAdmin();
        allow write: if false;
      }

    match /financialExceptions/{exceptionId} {
        allow read: if signedIn() && sameInstitution(resource.data.institutionId) && ownerOrAdmin();
        allow write: if false;
      }

    function hospitalityStaff() {
      return institutionHasModule("hospitality")
        && (ownerOrAdmin() || hasRole("Manager") || hasRole("Employee")
          || hasRole("Operator") || hasRole("Service Worker"));
    }

    match /hotelRooms/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin() && institutionHasModule("hospitality");
    }
    match /hotelReservations/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin() && institutionHasModule("hospitality");
    }
    match /hospitalityOutlets/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin() && institutionHasModule("hospitality");
    }
    match /hospitalityOrders/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }
    match /housekeepingTasks/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }
    match /maintenanceTickets/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }
    match /retailCatalogItems/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if ownerOrAdmin() && institutionHasModule("hospitality");
    }
    match /retailSales/{recordId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasModule("hospitality");
      allow create, update: if hospitalityStaff() && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId;
      allow delete: if false;
    }

    match /setupConfigs/{institutionId} {
      allow read: if sameInstitution(institutionId) && institutionHasModule("setup");
      allow create, update: if sameInstitution(institutionId) && institutionHasModule("setup") && setupOperator()
        && request.resource.data.institutionId == institutionId;
      allow delete: if false;
    }

    match /setupRequirements/{requirementId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("setup");
      allow create, update: if signedIn() && institutionHasModule("setup") && setupOperator()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && request.resource.data.requirementId == requirementId;
      allow delete: if false;
    }
    match /setupRecommendations/{recommendationId} {
      allow read: if sameInstitution(resource.data.institutionId) && institutionHasModule("setup");
      allow create, update: if institutionHasModule("setup") && setupOperator()
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && request.resource.data.recommendationId == recommendationId;
      allow delete: if false;
    }

    match /institutionSettings/{institutionId} {
      allow read, write: if false;

      match /sections/{sectionId} {
        allow read, write: if false;

        match /drafts/{draftId} {
          allow read, write: if false;
        }
      }
    }

    match /settingsAuditEvents/{eventId} {
      allow read, write: if false;
    }

    // Notifications are tenant-scoped and recipients may only mutate their own inbox.
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && institutionHasModule("notifications")
        && resource.data.recipientUid == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && sameInstitution(resource.data.institutionId)
        && institutionHasModule("notifications")
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.institutionId == resource.data.institutionId
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.eventId == resource.data.eventId;
      allow delete: if false;
    }

    // Integrations are managed by workspace administrators. Provider credentials,
    // webhook events and gateway side effects are server-only.
    match /integrations/{integrationId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId) && institutionHasFeature("external-integrations");
      allow create, update: if false;
      allow delete: if false;
    }
    match /integrationCredentials/{credentialId} {
      allow read, write: if false;
    }
    match /externalEvents/{eventId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId);
      allow write: if false;
    }
    match /integrationExceptions/{exceptionId} {
      allow read: if signedIn() && resource.data.institutionId != null
        && sameInstitution(resource.data.institutionId) && ownerOrAdmin();
      allow write: if false;
    }
    match /securityEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.eventId == eventId
        && request.resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["eventId", "institutionId", "uid", "type", "source", "details", "createdAt"])
        && request.resource.data.type in ["login", "workspace_lock", "workspace_unlock"]
        && request.resource.data.source in ["create_account", "login_form", "workspace_lock", "workspace_unlock", "idle_timer"]
        && request.resource.data.details is map
        && (
          (request.resource.data.type == "login" && request.resource.data.source in ["create_account", "login_form"])
          || (request.resource.data.type == "workspace_lock" && request.resource.data.source in ["workspace_lock", "idle_timer"])
          || (request.resource.data.type == "workspace_unlock" && request.resource.data.source in ["workspace_lock", "workspace_unlock"])
        );
      allow read: if signedIn() && sameInstitution(resource.data.institutionId)
        && (ownerOrAdmin() || request.auth.uid == resource.data.uid);
      allow update, delete: if false;
    }
    match /auditEvents/{eventId} {
      allow read: if signedIn() && sameInstitution(resource.data.institutionId);
      allow write: if false;
    }

    // Network profiles are an intentionally small public directory surface.
    // Operational and personal collections remain covered by their tenant rules.
    match /networkProfiles/{institutionId} {
      allow read: if signedIn() && resource.data.institutionId == institutionId
        && institutionHasModule("network")
        && !(resource.data.trustState in ["Restricted", "Suspended", "Revoked"]);
      allow create: if ownerOrAdmin()
        && institutionHasModule("network")
        && userDoc(request.auth.uid).data.institutionId == institutionId
        && request.resource.data.institutionId == institutionId
        && request.resource.data.keys().hasOnly(["institutionId", "institutionName", "broadLocation", "selectedServices", "participation", "contactEnabled", "trustState", "updatedAt"])
        && request.resource.data.trustState == "Registered";
      allow update: if ownerOrAdmin()
        && institutionHasModule("network")
        && userDoc(request.auth.uid).data.institutionId == institutionId
        && request.resource.data.institutionId == institutionId
        && request.resource.data.keys().hasOnly(["institutionId", "institutionName", "broadLocation", "selectedServices", "participation", "contactEnabled", "trustState", "updatedAt", "platformTrustState"])
        && request.resource.data.trustState == resource.data.trustState
        && (!("platformTrustState" in request.resource.data)
          || request.resource.data.platformTrustState == resource.data.platformTrustState);
      allow delete: if false;
    }

    match /assistanceRequests/{requestId} {
      allow read: if signedIn() && institutionHasModule("network") && (resource.data.requesterInstitutionId == userDoc(request.auth.uid).data.institutionId
        || resource.data.requestedInstitutionId == userDoc(request.auth.uid).data.institutionId);
      allow write: if false;
    }

    match /networkMemberships/{membershipId} {
      allow read: if signedIn() && institutionHasModule("network") && (resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        || resource.data.memberInstitutionId == userDoc(request.auth.uid).data.institutionId);
      allow write: if false;
    }

    match /dataSharingPermissions/{permissionId} {
      allow read: if signedIn() && institutionHasModule("network") && (resource.data.institutionId == userDoc(request.auth.uid).data.institutionId
        || resource.data.counterpartyInstitutionId == userDoc(request.auth.uid).data.institutionId);
      allow write: if false;
    }

    function contractParticipant(contract) {
      return signedIn() && institutionHasModule("network") && (contract.institutionAId == userDoc(request.auth.uid).data.institutionId
        || contract.institutionBId == userDoc(request.auth.uid).data.institutionId);
    }

    match /collaborationContracts/{contractId} {
      allow read: if contractParticipant(resource.data);
      allow write: if false;
    }

    match /networkWorkspaceRecords/{recordId} {
      allow read: if signedIn()
        && institutionHasModule("network")
        && exists(/databases/$(database)/documents/collaborationContracts/$(resource.data.contractId))
        && get(/databases/$(database)/documents/collaborationContracts/$(resource.data.contractId)).data.status == "active"
        && contractParticipant(get(/databases/$(database)/documents/collaborationContracts/$(resource.data.contractId)).data)
        && resource.data.scope in get(/databases/$(database)/documents/collaborationContracts/$(resource.data.contractId)).data.scopes;
      allow write: if false;
    }
  }
}
