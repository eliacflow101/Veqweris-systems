rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function sameInstitution(institutionId) {
      return signedIn() && userDoc().data.institutionId == institutionId;
    }

    function institutionHasModule(institutionId, moduleId) {
      let institution = firestore.get(/databases/(default)/documents/institutions/$(institutionId)).data;
      return institution.status == "active"
        && (
          ("entitlement" in institution
            && "modules" in institution.entitlement
            && moduleId in institution.entitlement.modules)
          || (!("entitlement" in institution)
            && (
              institution.planTier in ["internal", "developer", "partner", "enterprise"]
              || (institution.planTier in ["trial", "basic"]
                && moduleId in ["dashboard", "departments", "employees", "tasks", "planner", "messages", "notifications", "documents", "reports", "approvals", "settings", "inventory", "setup"])
              || (institution.planTier == "professional"
                && moduleId in ["dashboard", "departments", "employees", "tasks", "planner", "messages", "notifications", "documents", "reports", "approvals", "settings", "inventory", "setup", "compliance", "analytics", "operational-intelligence", "network", "school", "healthcare", "hospitality"])
            ))
        );
    }

    function ownerOrAdmin() {
      return signedIn() && userDoc().data.role in ["Owner", "Admin"];
    }

    match /quarantine/{institutionId}/{fileName} {
      allow read, write: if false;
    }

    match /documents/{institutionId}/{fileName} {
      allow read, write: if false;
    }
  }
}
